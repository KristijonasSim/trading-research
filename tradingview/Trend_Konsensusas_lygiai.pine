// TREND KONSENSUSAS – tik BUY / SELL signalai + mėnesio ir savaitės lygiai.
// 5 trendo sistemos balsuoja: EMA 20/200, SuperTrend 10/3, Donchian 40/20, Chandelier 10/4, Momentum 100.
// BUY: bent 3 iš 5 už kilimą. SELL: liko 1 ar 0. Signalai tik užsidarius žvakei – NEPERPIEŠIA.
// Laiko rėmas: D (dienos). Kripto, auksui, sidabrui, naftai tinka ir 4h. 1h ir mažiau – nenaudoti.
// Lygiai: artimiausias neišbandytas mėnesio (mėlyna) ir savaitės (geltona) žvakės kūno kraštas virš ir po kaina.

//@version=5
indicator("Trend Konsensusas BUY/SELL", overlay = true, max_lines_count = 20, max_labels_count = 200)

buyAt  = input.int(3, "BUY, kai balsų už kilimą bent", minval = 1, maxval = 5)
sellAt = input.int(1, "SELL, kai balsų liko ne daugiau", minval = 0, maxval = 4)

grpT    = "Pelno fiksavimo (TP) linijos"
showTP  = input.bool(true, "Rodyti TP linijas", group = grpT)
pivLen  = input.int(10, "Svarbaus aukščiausio/žemiausio taško dydis (žvakės)", minval = 3, group = grpT)
minDist = input.float(2.0, "TP ne arčiau nei (ATR kartai)", minval = 0.5, step = 0.5, group = grpT)
fallAtr = input.float(4.0, "Jei lygio nėra: TP = kaina ± ATR kartai", minval = 1, step = 0.5, group = grpT)
snapRnd = input.bool(true, "TP šiek tiek prieš apvalią kainą", group = grpT)

// 1. EMA 20/200
v1 = ta.ema(close, 20) > ta.ema(close, 200) ? 1 : 0
// 2. SuperTrend 10/3
[stLine, stDir] = ta.supertrend(3.0, 10)
v2 = stDir < 0 ? 1 : 0
// 3. Donchian 40/20
hhE = ta.highest(high, 40)[1]
llE = ta.lowest(low, 40)[1]
hhX = ta.highest(high, 20)[1]
llX = ta.lowest(low, 20)[1]
var int dState = 0
if dState == 1 and close < llX
    dState := 0
else if dState == -1 and close > hhX
    dState := 0
if dState <= 0 and close > hhE
    dState := 1
else if dState >= 0 and close < llE
    dState := -1
v3 = dState == 1 ? 1 : 0
// 4. Chandelier 10/4
catr = ta.rma(ta.tr(true), 10)
lst  = ta.highest(high, 10) - 4.0 * catr
sst  = ta.lowest(low, 10) + 4.0 * catr
var int   cState = 1
var float lStop  = na
var float sStop  = na
lStop := cState == 1 ? math.max(lst, nz(lStop, lst)) : lst
sStop := cState == -1 ? math.min(sst, nz(sStop, sst)) : sst
if cState == 1 and close < lStop
    cState := -1
    sStop := sst
else if cState == -1 and close > sStop
    cState := 1
    lStop := lst
v4 = cState == 1 ? 1 : 0
// 5. Momentum 100
v5 = close > close[100] ? 1 : 0

score = v1 + v2 + v3 + v4 + v5

// Būsena: 1 = pirkta, 0 = ne rinkoje
var int pos = 0
bool buy  = false
bool sell = false
if bar_index > 200 and barstate.isconfirmed
    if pos == 0 and score >= buyAt
        pos := 1
        buy := true
    else if pos == 1 and score <= sellAt
        pos := 0
        sell := true

// ---- TP: artimiausi svarbūs lygiai (buvę aukščiausi / žemiausi taškai), apvalios kainos ----
atrD = ta.atr(14)
ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low, pivLen, pivLen)
var hiLv = array.new_float()
var loLv = array.new_float()
if not na(ph)
    array.push(hiLv, ph)
    if array.size(hiLv) > 60
        array.shift(hiLv)
if not na(pl)
    array.push(loLv, pl)
    if array.size(loLv) > 60
        array.shift(loLv)

rndStep(p) => math.pow(10, math.floor(math.log10(p))) / 10
snapDn(lv) => snapRnd ? math.max(math.floor(lv / rndStep(lv) * 2) / 2 * rndStep(lv), lv - atrD * 0.5) : lv
snapUp(lv) => snapRnd ? math.min(math.ceil(lv / rndStep(lv) * 2) / 2 * rndStep(lv), lv + atrD * 0.5) : lv

// grąžina artimiausią lygį aukščiau (dir=1) arba žemiau (dir=-1), ne arčiau nei minDist ATR
nextLevel(dir, fromP) =>
    float best = na
    arr = dir == 1 ? hiLv : loLv
    for i = 0 to array.size(arr) - 1
        if array.size(arr) == 0
            break
        v = array.get(arr, i)
        if dir == 1 and v > fromP + atrD * minDist and (na(best) or v < best)
            best := v
        if dir == -1 and v < fromP - atrD * minDist and (na(best) or v > best)
            best := v
    na(best) ? fromP + dir * atrD * fallAtr : best

var line  l1 = na
var line  l2 = na
var label b1 = na
var label b2 = na
var float tp1 = na
var float tp2 = na
var int   tDir = 0
var bool  hit1 = false
var bool  hit2 = false

if showTP and (buy or sell)
    line.delete(l1)
    line.delete(l2)
    label.delete(b1)
    label.delete(b2)
    tDir := buy ? 1 : -1
    r1 = nextLevel(tDir, close)
    r2 = nextLevel(tDir, r1)
    tp1 := tDir == 1 ? snapDn(r1) : snapUp(r1)
    tp2 := tDir == 1 ? snapDn(r2) : snapUp(r2)
    hit1 := false
    hit2 := false
    cTP = tDir == 1 ? color.new(#00C853, 0) : color.new(#D50000, 0)
    l1 := line.new(bar_index, tp1, bar_index + 10, tp1, color = cTP, style = line.style_dashed, width = 2)
    l2 := line.new(bar_index, tp2, bar_index + 10, tp2, color = color.new(cTP, 40), style = line.style_dotted, width = 2)
    b1 := label.new(bar_index + 10, tp1, "TP1 " + str.tostring(tp1, format.mintick), style = label.style_label_left, color = color.new(cTP, 70), textcolor = color.white, size = size.small)
    b2 := label.new(bar_index + 10, tp2, "TP2 " + str.tostring(tp2, format.mintick), style = label.style_label_left, color = color.new(cTP, 85), textcolor = color.white, size = size.small)

// linijos tęsiasi iki dabarties, kol pasiekiamos
if showTP and tDir != 0 and not na(tp1)
    if not hit1
        hit1 := tDir == 1 ? high >= tp1 : low <= tp1
        line.set_x2(l1, bar_index + 10)
        label.set_x(b1, bar_index + 10)
        if hit1
            line.set_x2(l1, bar_index)
            label.set_x(b1, bar_index)
            label.set_text(b1, "TP1 pasiektas ✓")
    if not hit2
        hit2 := tDir == 1 ? high >= tp2 : low <= tp2
        line.set_x2(l2, bar_index + 10)
        label.set_x(b2, bar_index + 10)
        if hit2
            line.set_x2(l2, bar_index)
            label.set_x(b2, bar_index)
            label.set_text(b2, "TP2 pasiektas ✓")

// ---- Mėnesio ir savaitės lygiai (DMC: neišbandyti žvakių kūnų kraštai) ----
// Rodoma tik po vieną artimiausią lygį virš ir po kaina kiekvienam rėmui (daugiausia 4 linijos).
grpL  = "Mėnesio / savaitės lygiai"
showM = input.bool(true, "Mėnesio lygiai (mėlyna)", group = grpL)
showW = input.bool(true, "Savaitės lygiai (geltona)", group = grpL)
colM  = input.color(color.blue, "Mėnesio spalva", group = grpL)
colW  = input.color(color.yellow, "Savaitės spalva", group = grpL)

[mO, mC, mT] = request.security(syminfo.tickerid, "M", [open[1], close[1], time[1]], lookahead = barmerge.lookahead_on)
[wO, wC, wT] = request.security(syminfo.tickerid, "W", [open[1], close[1], time[1]], lookahead = barmerge.lookahead_on)
var mLv  = array.new_float()
var mArm = array.new_bool()
var wLv  = array.new_float()
var wArm = array.new_bool()

addLv(lv, arm, p) =>
    if not na(p)
        array.push(lv, p)
        array.push(arm, false)
    if array.size(lv) > 12
        array.shift(lv)
        array.shift(arm)
        0
    0

// lygis „įsijungia“, kai kaina nuo jo nutolsta; kai grįžta ir paliečia - pašalinamas
updLv(lv, arm) =>
    n = array.size(lv)
    if n > 0
        for i = n - 1 to 0
            p = array.get(lv, i)
            bool armed  = array.get(arm, i)
            bool hit    = armed and low <= p and high >= p
            bool armNow = not armed and math.abs(close - p) > 1.5 * atrD
            if hit
                array.remove(lv, i)
                array.remove(arm, i)
                0
            if armNow
                array.set(arm, i, true)
                0
    0

nearLv(lv, dir) =>
    float best = na
    n = array.size(lv)
    if n > 0
        for i = 0 to n - 1
            p = array.get(lv, i)
            if dir == 1 and p > close and (na(best) or p < best)
                best := p
            if dir == -1 and p < close and (na(best) or p > best)
                best := p
    best

if ta.change(mT) != 0
    addLv(mLv, mArm, math.max(mO, mC))
    addLv(mLv, mArm, math.min(mO, mC))
if ta.change(wT) != 0
    addLv(wLv, wArm, math.max(wO, wC))
    addLv(wLv, wArm, math.min(wO, wC))
updLv(mLv, mArm)
updLv(wLv, wArm)

var line mUp = na
var line mDn = na
var line wUp = na
var line wDn = na
drawLv(line ln, p, c, w) =>
    line.delete(ln)
    na(p) ? line(na) : line.new(bar_index - 1, p, bar_index, p, extend = extend.both, color = c, width = w)

if barstate.islast
    mUp := drawLv(mUp, showM ? nearLv(mLv, 1) : na, colM, 3)
    mDn := drawLv(mDn, showM ? nearLv(mLv, -1) : na, colM, 3)
    wUp := drawLv(wUp, showW ? nearLv(wLv, 1) : na, colW, 2)
    wDn := drawLv(wDn, showW ? nearLv(wLv, -1) : na, colW, 2)

plotshape(buy,  "BUY",  shape.labelup,   location.belowbar, color.new(#00C853, 0), text = "BUY",  textcolor = color.white, size = size.normal)
plotshape(sell, "SELL", shape.labeldown, location.abovebar, color.new(#D50000, 0), text = "SELL", textcolor = color.white, size = size.normal)

alertcondition(buy,  "BUY",  "Trend Konsensusas: BUY")
alertcondition(sell, "SELL", "Trend Konsensusas: SELL")

// CE 50% Model - INDIKATORIUS (signalai be backtesto). Patikrinta: tradingview/ce50/REZULTATAI.md
// Taisyklės:
//  1) 8:30-9:30 (Niujorko laiku) rėžis: max, min, vidurys 50 %.
//  2) Pirmoji 3 min. žvakė nuo 9:30 užsidaro VIRŠ vidurio -> BUY kitos žvakės atidarymu.
//     (Žemiau vidurio -> SELL; išjungta pagal nutylėjimą.)
//  3) Stop: rėžio min. Kai užsidaro nauja patvirtinta 15 min. swing low (nuo 10:00), stop pakeliamas iki jos.
//  4) Uždaryti 16:00.
// Grafikas: NAS100 arba NQ1!/MNQ1!, 1 min. arba 3 min.
// Pranešimai: Alert -> Condition: "CE50 NAS100" -> "Any alert() function call".
//@version=6
indicator("CE50 NAS100", overlay = true)

allowShort = input.bool(false, "Rodyti ir SELL signalus")
showRange  = input.bool(true, "Rodyti 8:30-9:30 rėžį")

TZ = "America/New_York"
mins(t) => hour(t, TZ) * 60 + minute(t, TZ)
nowM   = mins(time)
closeM = mins(time_close)

// 1) 8:30-9:30 rėžis
inRange = nowM >= 510 and nowM < 570
var float rh = na
var float rl = na
if inRange and not inRange[1]
    rh := high
    rl := low
else if inRange
    rh := math.max(rh, high)
    rl := math.min(rl, low)
mid = (rh + rl) / 2
rangeDone = nowM >= 570 and nowM < 960

// 2) Signalas: žvakė, kuri užsidaro 9:33
sigBar   = closeM == 573 and not na(rh)
longSig  = sigBar and close > mid
shortSig = sigBar and close < mid and allowShort

// 3) Patvirtinti 15 min. swing low / high (be ateities duomenų)
pl  = request.security(syminfo.tickerid, "15", ta.pivotlow(low, 1, 1)[1], lookahead = barmerge.lookahead_on)
ph  = request.security(syminfo.tickerid, "15", ta.pivothigh(high, 1, 1)[1], lookahead = barmerge.lookahead_on)
q15 = request.security(syminfo.tickerid, "15", time[1], lookahead = barmerge.lookahead_on)
new15 = ta.change(q15) != 0
pivOk = mins(q15) >= 600 and dayofmonth(q15, TZ) == dayofmonth(time, TZ)

// Pozicijos sekimas (pozicija = 1 long, -1 short, 0 nėra)
var int   pos  = 0
var float stop = na
var float entry = na
exitSig = false
stopMoved = false

// stop pataikytas šioje žvakėje
if pos == 1 and low <= stop
    pos := 0
    exitSig := true
if pos == -1 and high >= stop
    pos := 0
    exitSig := true
// uždarymas 16:00
if pos != 0 and closeM >= 960
    pos := 0
    exitSig := true
// stop traukimas
if pos == 1 and new15 and pivOk and not na(pl) and pl > stop
    stop := pl
    stopMoved := true
if pos == -1 and new15 and pivOk and not na(ph) and ph < stop
    stop := ph
    stopMoved := true
// naujas signalas (įėjimas kitos žvakės atidarymu)
if longSig
    pos := 1
    stop := rl
    entry := close
if shortSig
    pos := -1
    stop := rh
    entry := close

if longSig
    alert("CE50 BUY " + syminfo.ticker + " ~" + str.tostring(close, format.mintick) + " | stop " + str.tostring(rl, format.mintick), alert.freq_once_per_bar_close)
if shortSig
    alert("CE50 SELL " + syminfo.ticker + " ~" + str.tostring(close, format.mintick) + " | stop " + str.tostring(rh, format.mintick), alert.freq_once_per_bar_close)
if stopMoved
    alert("CE50 stop perkeltas į " + str.tostring(stop, format.mintick), alert.freq_once_per_bar_close)
if exitSig
    alert("CE50 UŽDARYTI " + syminfo.ticker, alert.freq_once_per_bar_close)

// Vaizdas
plot(showRange and rangeDone ? rh : na, "Rėžio max", color.gray, 1, plot.style_linebr)
plot(showRange and rangeDone ? rl : na, "Rėžio min", color.gray, 1, plot.style_linebr)
plot(showRange and rangeDone ? mid : na, "50 %", color.orange, 2, plot.style_linebr)
plot(pos != 0 ? stop : na, "Stop", color.red, 2, plot.style_linebr)
plot(pos != 0 ? entry : na, "Įėjimas", color.new(color.green, 40), 1, plot.style_linebr)
plotshape(longSig, "BUY", shape.triangleup, location.belowbar, color.green, size = size.small, text = "BUY")
plotshape(shortSig, "SELL", shape.triangledown, location.abovebar, color.red, size = size.small, text = "SELL")
plotshape(exitSig, "Uždaryti", shape.xcross, location.abovebar, color.gray, size = size.tiny, text = "EXIT")
bgcolor(showRange and inRange ? color.new(color.blue, 92) : na, title = "8:30-9:30")

alertcondition(longSig, "CE50 BUY", "CE50 BUY {{ticker}} {{close}}")
alertcondition(shortSig, "CE50 SELL", "CE50 SELL {{ticker}} {{close}}")
alertcondition(exitSig, "CE50 uždaryti", "CE50 UŽDARYTI {{ticker}}")
